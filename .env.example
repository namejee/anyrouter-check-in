# AnyRouter / AgentRouter OAuth 账号配置：复制 GitHub/LinuxDO 登录后的完整 Cookie
ANYROUTER_ACCOUNTS=[{"name":"GitHub账号","provider":"anyrouter.top","cookies":{"session":"你的session值","acw_tc":"你的acw_tc值","cdn_sec_tc":"你的cdn_sec_tc值","acw_sc__v2":"你的acw_sc__v2值"},"api_user":"你的api_user值"},{"name":"LinuxDO账号","provider":"agentrouter.org","cookies":{"session":"你的session值","acw_tc":"你的acw_tc值"},"api_user":"你的api_user值"}]
# 仅支持原生密码登录的平台可改用 credentials；GitHub/LinuxDO OAuth 不要填密码
# ANYROUTER_ACCOUNTS=[{"provider":"agentrouter.org","credentials":{"username":"你的用户名或邮箱","password":"你的密码"}}]

# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_gotify_token
# GOTIFY_PRIORITY=9
